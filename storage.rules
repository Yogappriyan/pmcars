rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper to check if the caller is an authenticated user
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Vehicle images:
    // Public read allows website visitors to view vehicle photos
    // Write/delete is strictly limited to authenticated users with image content constraints
    match /vehicles/{vehicleId}/{allImages=**} {
      allow read: if true;
      allow write, delete: if isSignedIn()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
